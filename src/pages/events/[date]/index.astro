---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import PageLayout from '~/layouts/PageLayout.astro';
import { eventOccursOnDate, getAllEvents, getEventDates, getEventPermalink, isFeaturedEvent } from '~/utils/events';

export const prerender = true;

export const getStaticPaths = (async () => {
  const events = await getAllEvents();
  const dates = [...new Set(events.flatMap(getEventDates))];
  return dates.map((date) => ({
    params: { date },
    props: { date, events: events.filter((event) => eventOccursOnDate(event, date)) },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { date, events } = Astro.props as Props;
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'America/New_York',
});
const eventFormatter = new Intl.DateTimeFormat('en-US', {
  weekday: 'short',
  month: 'short',
  day: 'numeric',
  hour: 'numeric',
  minute: '2-digit',
  timeZone: 'America/New_York',
});
const dateLabel = dateFormatter.format(new Date(`${date}T12:00:00Z`));
const formatEventRange = (event: (typeof events)[number]) => {
  const start = eventFormatter.format(new Date(event.data.start));
  return event.data.end ? `${start} – ${eventFormatter.format(new Date(event.data.end))}` : start;
};
---

<PageLayout metadata={{ title: `Events on ${dateLabel}`, description: `Space Coast tech events on ${dateLabel}.` }}>
  <section class="py-12 md:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <a class="text-sm text-primary hover:underline" href="/events">← All events</a>
      <h1 class="mt-8 text-4xl font-bold tracking-tight">Events on {dateLabel}</h1>
      <div class="mt-8 space-y-4">
        {
          events.map((event) => (
            <article
              class:list={[
                'rounded-lg border p-5',
                isFeaturedEvent(event)
                  ? 'border-[#1967d2] bg-blue-50 ring-2 ring-[#1967d2]/40 dark:bg-blue-950/30'
                  : 'border-gray-200 dark:border-slate-700',
              ]}
            >
              <p class="text-lg font-bold text-primary">{formatEventRange(event)}</p>
              {isFeaturedEvent(event) && (
                <p class="mt-2 inline-block rounded-full bg-[#1967d2] px-2 py-1 text-xs font-bold uppercase tracking-wide text-white">
                  Featured event
                </p>
              )}
              <h2 class="mt-2 text-xl font-semibold">
                <a class="hover:text-primary" href={getEventPermalink(event)}>
                  {event.data.title}
                </a>
              </h2>
              <p class="mt-2 text-sm text-muted dark:text-slate-400">{event.data.organizer.name}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</PageLayout>

---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import PageLayout from '~/layouts/PageLayout.astro';
import { getAllEvents, getEventPermalink } from '~/utils/events';

export const prerender = true;

export const getStaticPaths = (async () => {
  const events = await getAllEvents();
  const dates = [...new Set(events.map((event) => event.data.start.slice(0, 10)))];
  return dates.map((date) => ({
    params: { date },
    props: { date, events: events.filter((event) => event.data.start.slice(0, 10) === date) },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { date, events } = Astro.props as Props;
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'America/New_York',
});
const timeFormatter = new Intl.DateTimeFormat('en-US', {
  hour: 'numeric',
  minute: '2-digit',
  timeZone: 'America/New_York',
});
const dateLabel = dateFormatter.format(new Date(`${date}T12:00:00Z`));
---

<PageLayout metadata={{ title: `Events on ${dateLabel}`, description: `Space Coast tech events on ${dateLabel}.` }}>
  <section class="py-12 md:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <a class="text-sm text-primary hover:underline" href="/events">← All events</a>
      <h1 class="mt-8 text-4xl font-bold tracking-tight">Events on {dateLabel}</h1>
      <div class="mt-8 space-y-4">
        {
          events.map((event) => (
            <article class="rounded-lg border border-gray-200 p-5 dark:border-slate-700">
              <p class="text-lg font-bold text-primary">{timeFormatter.format(new Date(event.data.start))}</p>
              <h2 class="mt-2 text-xl font-semibold">
                <a class="hover:text-primary" href={getEventPermalink(event)}>
                  {event.data.title}
                </a>
              </h2>
              <p class="mt-2 text-sm text-muted dark:text-slate-400">{event.data.organizer.name}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</PageLayout>

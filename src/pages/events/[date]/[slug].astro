---
import { isStormCancelledEvent } from '~/utils/event-cancellation';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import PageLayout from '~/layouts/PageLayout.astro';
import { getAllEvents, getEventCostLabel, isFeaturedEvent } from '~/utils/events';

export const prerender = true;

export const getStaticPaths = (async () => {
  const events = await getAllEvents();
  return events.map((event) => ({
    params: { date: event.data.start.slice(0, 10), slug: event.data.slug },
    props: { event },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { event } = Astro.props as Props;
const { data } = event;
const isStormCancellation = isStormCancelledEvent(event);
const cancellationMessage = 'Due to the storms we are cancelling the meetup today. Stay dry out there!';
const cancellationGraphic = '/event-images/2026-11-18-meetup-canceled.webp';
const start = new Date(data.start);
const end = data.end ? new Date(data.end) : undefined;
const descriptionParagraphs = data.description.split(/\n{2,}/);
const formatter = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  hour: 'numeric',
  minute: '2-digit',
  timeZone: 'America/New_York',
  timeZoneName: 'short',
});
const eventDate = data.start.slice(0, 10);
const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: data.title,
  description: isStormCancellation ? cancellationMessage : data.description,
  startDate: data.start,
  ...(data.end ? { endDate: data.end } : {}),
  eventAttendanceMode: `https://schema.org/${data.attendanceMode === 'online' ? 'OnlineEventAttendanceMode' : data.attendanceMode === 'mixed' ? 'MixedEventAttendanceMode' : 'OfflineEventAttendanceMode'}`,
  eventStatus: isStormCancellation ? 'https://schema.org/EventCancelled' : 'https://schema.org/EventScheduled',
  url: data.sourceUrl,
  organizer: { '@type': 'Organization', name: data.organizer.name, url: data.organizer.url },
  ...(data.location
    ? {
        location: {
          '@type': 'Place',
          name: data.location.name,
          address: {
            '@type': 'PostalAddress',
            ...(data.location.address ? { streetAddress: data.location.address } : {}),
            ...(data.location.city ? { addressLocality: data.location.city } : {}),
            ...(data.location.region ? { addressRegion: data.location.region } : {}),
            ...(data.location.postalCode ? { postalCode: data.location.postalCode } : {}),
          },
        },
      }
    : {}),
};
const eventSchemaJson = JSON.stringify(eventSchema).replace(/</g, '\\u003c');
---

<PageLayout
  metadata={{
    title: data.title,
    description: isStormCancellation ? cancellationMessage : data.description,
    canonical: data.sourceUrl,
  }}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={eventSchemaJson} />
  </Fragment>
  <section class="py-12 md:py-20">
    <article class="mx-auto max-w-3xl px-4 sm:px-6">
      <a class="text-sm text-primary hover:underline" href={`/events#event-${eventDate}-${data.slug}`}>← All events</a>
      {
        isFeaturedEvent(event) && (
          <p class="mt-4 w-fit rounded-full bg-[#1967d2] px-3 py-1 text-sm font-bold uppercase tracking-wide text-white">
            Featured event
          </p>
        )
      }
      {
        isStormCancellation && (
          <section
            class="my-6 rounded-lg border border-rose-500 bg-rose-50 p-5 text-rose-950 dark:bg-rose-950 dark:text-rose-100"
            aria-labelledby="cancellation-title"
          >
            <h2 class="text-2xl font-bold" id="cancellation-title">
              November 18 meetup canceled
            </h2>
            <p class="mt-2 text-lg">{cancellationMessage}</p>
            <img
              class="mx-auto mt-4 h-auto w-full max-w-md rounded-lg"
              src={cancellationGraphic}
              alt=""
              width="1080"
              height="1080"
            />
          </section>
        )
      }
      <p
        class:list={[
          'text-sm font-semibold uppercase tracking-wide text-muted dark:text-slate-400',
          isFeaturedEvent(event) ? 'mt-4' : 'mt-8',
        ]}
      >
        Date & time
      </p>
      <p class="mt-1 text-2xl font-bold text-primary sm:text-3xl">
        <time datetime={data.start}>{formatter.format(start)}</time>
        {
          end && (
            <>
              <>
                <span aria-hidden="true"> – </span>
                <time datetime={data.end}>{formatter.format(end)}</time>
              </>
            </>
          )
        }
      </p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight">{data.title}</h1>
      {
        data.cost && (
          <p
            class:list={[
              'mt-4 inline-block rounded-full px-3 py-1 text-sm font-bold uppercase tracking-wide',
              data.cost.type === 'free'
                ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-200'
                : 'bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-200',
            ]}
          >
            {getEventCostLabel(event)}
          </p>
        )
      }
      {
        !isStormCancellation && data.imageUrl && (
          <img
            class="mt-6 h-auto max-h-[36rem] w-full rounded-lg object-contain"
            src={data.imageUrl}
            alt={`Event image for ${data.title}`}
            referrerpolicy="no-referrer"
          />
        )
      }
      <div class="mt-6 space-y-4 text-lg text-muted dark:text-slate-400">
        {descriptionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <dl class="mt-8 space-y-4 border-y border-gray-200 py-6 dark:border-slate-700">
        <div>
          <dt class="font-semibold">Organizer</dt>
          <dd><a class="text-primary hover:underline" href={data.organizer.url}>{data.organizer.name}</a></dd>
        </div>
        {
          data.location && (
            <div>
              <dt class="font-semibold">Location</dt>
              <dd>
                {[data.location.name, data.location.address, data.location.city, data.location.region]
                  .filter(Boolean)
                  .join(', ')}
              </dd>
            </div>
          )
        }
      </dl>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn-primary" href={data.sourceUrl} target="_blank" rel="noopener noreferrer">View event source</a>
        {
          !isStormCancellation && (
            <a class="btn-secondary" href={`/events/${eventDate}/${data.slug}.ics`}>
              Add to calendar
            </a>
          )
        }
      </div>
    </article>
  </section>
</PageLayout>

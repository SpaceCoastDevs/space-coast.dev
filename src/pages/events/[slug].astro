---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import PageLayout from '~/layouts/PageLayout.astro';
import { getAllEvents } from '~/utils/events';

export const prerender = true;

export const getStaticPaths = (async () => {
  const events = await getAllEvents();
  return events.map((event) => ({ params: { slug: event.data.slug }, props: { event } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { event } = Astro.props as Props;
const { data } = event;
const start = new Date(data.start);
const descriptionParagraphs = data.description.split(/\n{2,}/);
const formatter = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  hour: 'numeric',
  minute: '2-digit',
  timeZone: 'America/New_York',
  timeZoneName: 'short',
});
const eventUrl = new URL(`/events/${data.slug}`, Astro.site);
const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: data.title,
  description: data.description,
  startDate: data.start,
  ...(data.end ? { endDate: data.end } : {}),
  eventAttendanceMode: `https://schema.org/${data.attendanceMode === 'online' ? 'OnlineEventAttendanceMode' : data.attendanceMode === 'mixed' ? 'MixedEventAttendanceMode' : 'OfflineEventAttendanceMode'}`,
  eventStatus: 'https://schema.org/EventScheduled',
  url: eventUrl.toString(),
  organizer: { '@type': 'Organization', name: data.organizer.name, url: data.organizer.url },
  ...(data.location
    ? {
        location: {
          '@type': 'Place',
          name: data.location.name,
          address: {
            '@type': 'PostalAddress',
            ...(data.location.address ? { streetAddress: data.location.address } : {}),
            ...(data.location.city ? { addressLocality: data.location.city } : {}),
            ...(data.location.region ? { addressRegion: data.location.region } : {}),
            ...(data.location.postalCode ? { postalCode: data.location.postalCode } : {}),
          },
        },
      }
    : {}),
};
const eventSchemaJson = JSON.stringify(eventSchema).replace(/</g, '\\u003c');
---

<PageLayout metadata={{ title: data.title, description: data.description }}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={eventSchemaJson} />
  </Fragment>
  <section class="py-12 md:py-20">
    <article class="mx-auto max-w-3xl px-4 sm:px-6">
      <a class="text-sm text-primary hover:underline" href={`/events#event-${data.slug}`}>← All events</a>
      <p class="mt-8 text-sm font-semibold uppercase tracking-wide text-muted dark:text-slate-400">Date & time</p>
      <p class="mt-1 text-2xl font-bold text-primary sm:text-3xl">{formatter.format(start)}</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight">{data.title}</h1>
      <div class="mt-6 space-y-4 text-lg text-muted dark:text-slate-400">
        {descriptionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <dl class="mt-8 space-y-4 border-y border-gray-200 py-6 dark:border-slate-700">
        <div>
          <dt class="font-semibold">Organizer</dt>
          <dd><a class="text-primary hover:underline" href={data.organizer.url}>{data.organizer.name}</a></dd>
        </div>
        {
          data.location && (
            <div>
              <dt class="font-semibold">Location</dt>
              <dd>
                {[data.location.name, data.location.address, data.location.city, data.location.region]
                  .filter(Boolean)
                  .join(', ')}
              </dd>
            </div>
          )
        }
      </dl>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn-primary" href={data.sourceUrl} target="_blank" rel="noopener noreferrer">View event source</a>
        <a class="btn-secondary" href={`/events/${data.slug}.ics`}>Add to calendar</a>
      </div>
    </article>
  </section>
</PageLayout>

---
export const prerender = false;

import PageLayout from '~/layouts/PageLayout.astro';
import { getFacebookTestSession } from '~/lib/facebook-page-test';
import { getSocialAdmin } from '~/lib/social-admin';

const admin = await getSocialAdmin(Astro.request);
if (!admin) return new Response('Not found', { status: 404 });

const session = await getFacebookTestSession(Astro.request, admin.discordId);
const status = Astro.url.searchParams.get('status');
const error = Astro.url.searchParams.get('error');
const postId = Astro.url.searchParams.get('post_id');
---

<PageLayout
  metadata={{ title: 'Facebook App Review Test — Space Coast Devs', robots: { index: false, follow: false } }}
>
  <section class="py-12 md:py-20">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Facebook App Review Test</h1>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
        This private page is for recording the Meta App Review flow. It expires the temporary Page connection after ten
        minutes.
      </p>

      {
        error && (
          <div class="mt-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-800 dark:bg-red-950 dark:text-red-200">
            {error}
          </div>
        )
      }
      {
        status === 'connected' && (
          <div class="mt-6 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800 dark:border-green-800 dark:bg-green-950 dark:text-green-200">
            Connected to {session?.pageName ?? 'the configured Facebook Page'}.
          </div>
        )
      }
      {
        status === 'posted' && (
          <div class="mt-6 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800 dark:border-green-800 dark:bg-green-950 dark:text-green-200">
            Test post created successfully (ID: {postId}). You can now show it on the Space Coast Devs Facebook Page.
          </div>
        )
      }

      <div
        class="mt-8 rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900"
      >
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">1. Connect the Space Coast Devs Page</h2>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
          Sign in with the Facebook account that has full control of the Space Coast Devs Page and grant the requested
          Page permissions.
        </p>
        <a
          href="/api/social/facebook/connect"
          class="mt-4 inline-flex rounded-lg bg-primary px-4 py-2.5 text-sm font-medium text-white hover:opacity-90"
          >Connect Facebook Page</a
        >
      </div>

      <div
        class="mt-5 rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900"
      >
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">2. Publish a labelled test post</h2>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
          The post links to the public event calendar and is labelled as an App Review test. Remove it from Facebook
          after recording if you do not want to keep it.
        </p>
        {
          session ? (
            <form method="POST" action="/api/social/facebook/test-post" class="mt-4">
              <input type="hidden" name="confirm" value="publish-test-post" />
              <button
                type="submit"
                class="rounded-lg bg-primary px-4 py-2.5 text-sm font-medium text-white hover:opacity-90"
              >
                Publish test post
              </button>
            </form>
          ) : (
            <p class="mt-4 text-sm font-medium text-amber-700 dark:text-amber-300">
              Connect the Page first to enable test posting.
            </p>
          )
        }
      </div>
    </div>
  </section>
</PageLayout>

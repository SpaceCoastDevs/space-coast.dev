---
import {
  getEventCostLabel,
  getEventsForDateRange,
  getEventPermalink,
  getEventsForMonth,
  isFeaturedEvent,
  isSpaceCoastDevsEvent,
} from '~/utils/events';

interface Props {
  month?: string;
  weekOf?: string;
}

const { month, weekOf } = Astro.props;

if (!month && !weekOf) {
  throw new Error('EventList requires either a month or a weekOf prop.');
}

const getWeekRange = (date: string): [string, string] => {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) {
    throw new Error('EventList weekOf must use YYYY-MM-DD format.');
  }

  const weekStart = new Date(`${date}T00:00:00Z`);
  if (Number.isNaN(weekStart.valueOf())) {
    throw new Error('EventList weekOf must be a valid date.');
  }

  // getUTCDay is Sunday = 0, so shift it to Monday = 0.
  weekStart.setUTCDate(weekStart.getUTCDate() - ((weekStart.getUTCDay() + 6) % 7));
  const weekEnd = new Date(weekStart);
  weekEnd.setUTCDate(weekStart.getUTCDate() + 7);
  return [weekStart.toISOString().slice(0, 10), weekEnd.toISOString().slice(0, 10)];
};

const events = weekOf ? await getEventsForDateRange(...getWeekRange(weekOf)) : await getEventsForMonth(month!);
const formatter = new Intl.DateTimeFormat('en-US', {
  weekday: 'short',
  month: 'short',
  day: 'numeric',
  hour: 'numeric',
  minute: '2-digit',
  timeZone: 'America/New_York',
});
const formatEventRange = (event: (typeof events)[number]) => {
  const start = formatter.format(new Date(event.data.start));
  return event.data.end ? `${start} – ${formatter.format(new Date(event.data.end))}` : start;
};
---

<div class="not-prose my-8 space-y-4">
  {
    events.length ? (
      events.map((event) => (
        <article
          class:list={[
            'rounded-lg border p-5',
            isFeaturedEvent(event)
              ? 'border-[#1967d2] bg-blue-50 ring-2 ring-[#1967d2]/40 dark:bg-blue-950/30'
              : isSpaceCoastDevsEvent(event)
                ? 'border-primary bg-blue-50 ring-1 ring-primary/30 dark:bg-slate-800'
                : 'border-gray-200 dark:border-slate-700',
          ]}
        >
          <div class="flex flex-col gap-4 sm:flex-row">
            {event.data.imageUrl && (
              <img
                class="h-auto max-h-52 w-full self-start rounded-md object-contain sm:w-52"
                src={event.data.imageUrl}
                alt={`Event image for ${event.data.title}`}
                loading="lazy"
                referrerpolicy="no-referrer"
              />
            )}
            <div class="min-w-0 flex-1">
              <p class="text-sm text-muted dark:text-slate-400">{formatEventRange(event)}</p>
              {(isFeaturedEvent(event) || isSpaceCoastDevsEvent(event) || event.data.cost) && (
                <div class="mt-2 flex flex-wrap items-center gap-2">
                  {isFeaturedEvent(event) && (
                    <span class="rounded-full bg-[#1967d2] px-2 py-1 text-xs font-bold uppercase tracking-wide text-white">
                      Featured event
                    </span>
                  )}
                  {isSpaceCoastDevsEvent(event) && (
                    <span class="rounded-full bg-primary px-2 py-1 text-xs font-bold uppercase tracking-wide text-white">
                      Space Coast Devs event
                    </span>
                  )}
                  {event.data.cost && (
                    <span
                      class:list={[
                        'rounded-full px-2 py-1 text-xs font-bold uppercase tracking-wide',
                        event.data.cost.type === 'free'
                          ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-200'
                          : 'bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-200',
                      ]}
                    >
                      {getEventCostLabel(event)}
                    </span>
                  )}
                </div>
              )}
              <h2 class="mt-1 text-xl font-semibold">
                <a class="hover:text-primary" href={getEventPermalink(event)}>
                  {event.data.title}
                </a>
              </h2>
              <p class="mt-2 text-sm text-muted dark:text-slate-400">
                {event.data.organizer.name}
                {event.data.location ? ` · ${event.data.location.name}` : ''}
              </p>
              <a
                class="mt-3 inline-block text-sm font-medium text-primary hover:underline"
                href={getEventPermalink(event)}
              >
                View details & add to calendar →
              </a>
            </div>
          </div>
        </article>
      ))
    ) : (
      <p class="rounded-lg border border-gray-200 p-5 text-muted dark:border-slate-700 dark:text-slate-400">
        No events are listed for this week yet. Check the event directory for upcoming events.
      </p>
    )
  }
</div>

---
const expiresAt = '2026-11-19T05:00:00Z';
---

{
  Date.now() < Date.parse(expiresAt) && (
    <aside
      data-meetup-notice-expires={expiresAt}
      aria-label="Meetup cancellation"
      class="bg-rose-800 px-4 py-3 text-center text-sm text-white"
    >
      <a class="font-bold underline underline-offset-4" href="/events/2026-11-18/space-coast-devs-monthly-meetup">
        Nov 18 Space Coast Devs meetup canceled due to storms
      </a>
      <span class="ml-1">Stay dry out there!</span>
    </aside>
  )
}

<script>
  for (const notice of document.querySelectorAll<HTMLElement>('[data-meetup-notice-expires]')) {
    const expires = Date.parse(notice.dataset.meetupNoticeExpires ?? '');
    if (Number.isFinite(expires) && Date.now() >= expires) notice.hidden = true;
  }
</script>
